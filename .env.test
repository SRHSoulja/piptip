# Test Environment Configuration
# This file contains safe test values for running the prediction markets test suite

# Database - Use test database (PostgreSQL compatible)
DATABASE_URL="postgresql://test:test@localhost:5432/test_prediction_markets"

# Discord Bot (not needed for most tests)
DISCORD_TOKEN="TEST_DISCORD_TOKEN_NOT_REAL"

# Admin Secret for API testing
ADMIN_SECRET="test-admin-secret-for-testing-only"

# Session Secret
SESSION_SECRET="test-session-secret-for-testing-only"

# Disable external services during testing
ABSTRACT_RPC_URL="http://localhost:8545"

# Test mode flag
NODE_ENV="test"

# Disable Redis for tests
REDIS_URL=""
REDIS_HOST=""

# Test token addresses
TEST_TOKEN_ADDRESS="0x1234567890123456789012345678901234567890"

# Disable external API calls during testing
DISABLE_EXTERNAL_APIS="true"