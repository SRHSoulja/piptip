# Test Environment Configuration
# This file contains safe test values for running the prediction markets test suite
# IMPORTANT: This uses a dedicated test database on port 5433 (not production!)

# Test Database - Points to Docker test database on port 5433
TEST_DATABASE_URL="postgresql://piptip_test:test_password_change_in_production@localhost:5433/piptip_test?schema=public"
DATABASE_URL="${TEST_DATABASE_URL}"

# Discord Bot (not needed for most tests)
DISCORD_TOKEN="TEST_DISCORD_TOKEN_NOT_REAL"

# Admin Secret for API testing
ADMIN_SECRET="test-admin-secret-for-testing-only"

# Session Secret
SESSION_SECRET="test-session-secret-for-testing-only"

# Network Configuration - Testnet only
NETWORK="testnet"
TESTNET_RPC_URL="https://api.testnet.abs.xyz"
MAINNET_RPC_URL=""  # Not used in tests

# Test mode flag
NODE_ENV="test"

# Test Redis (optional, points to Docker on port 6380)
REDIS_URL="redis://localhost:6380"
REDIS_HOST="localhost"
REDIS_PORT="6380"

# Test token addresses
TEST_TOKEN_ADDRESS="0x1234567890123456789012345678901234567890"

# Disable external API calls during testing
DISABLE_EXTERNAL_APIS="true"