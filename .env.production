# Production Environment Configuration for PIPTip
# Copy this to your production environment and update with real values

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
NODE_ENV=production
PORT=3000

# ============================================================================
# CLUSTERING AND SCALING
# ============================================================================
# Horizontal Scaling Configuration
MIN_NODES=2
MAX_NODES=16
CPU_THRESHOLD=80
MEMORY_THRESHOLD=85
CONNECTION_THRESHOLD=1000
SCALE_UP_COOLDOWN=300000
SCALE_DOWN_COOLDOWN=600000
HEALTH_CHECK_INTERVAL=30000

# Load Balancing Strategy: round_robin | least_connections | cpu_based | weighted
LOAD_BALANCE_STRATEGY=least_connections

# ============================================================================
# CDN CONFIGURATION
# ============================================================================
CDN_ENABLED=true
CDN_PROVIDER=cloudflare
CDN_BASE_URL=https://cdn.piptip.com
CDN_API_KEY=your_cloudflare_api_key_here
CDN_ZONE_ID=your_cloudflare_zone_id_here

# ============================================================================
# REDIS CONFIGURATION (Enhanced Performance)
# ============================================================================
REDIS_URL=redis://production-redis:6379
REDIS_CLUSTER_ENABLED=false
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_ON_FAILURE=100

# Redis Cache Settings
CACHE_TTL_SESSIONS=3600
CACHE_TTL_BALANCES=300
CACHE_TTL_USERS=1800
CACHE_TTL_LEADERBOARDS=60

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_BURST_MULTIPLIER=1.5

# ============================================================================
# DATABASE OPTIMIZATION
# ============================================================================
DATABASE_URL=postgresql://username:password@production-db:5432/piptip_prod
DB_CONNECTION_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=60000
DB_QUERY_TIMEOUT=30000

# Performance Optimization
DB_CACHE_ENABLED=true
DB_CACHE_TTL=300
DB_SLOW_QUERY_LOG=true
DB_SLOW_QUERY_THRESHOLD=1000

# ============================================================================
# DISCORD BOT CONFIGURATION
# ============================================================================
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_main_guild_id_here
DISCORD_WEBHOOK_SECRET=your_discord_webhook_secret_here

# ============================================================================
# BLOCKCHAIN CONFIGURATION
# ============================================================================
ABSTRACT_RPC_URL=https://api.testnet.abs.xyz
TREASURY_PRIVATE_KEY=your_treasury_private_key_here
TREASURY_ADDRESS=your_treasury_address_here

# Token Addresses on Abstract Chain
PENGUIN_TOKEN_ADDRESS=0x123...
ICE_TOKEN_ADDRESS=0x456...
PEBBLE_TOKEN_ADDRESS=0x789...

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
ADMIN_SECRET=your_ultra_secure_admin_secret_here
SESSION_SECRET=your_ultra_secure_session_secret_here
JWT_SECRET=your_ultra_secure_jwt_secret_here

# 2FA Configuration
TOTP_ISSUER=PIPTip Admin
ADMIN_2FA_REQUIRED=true

# Security Monitoring
SECURITY_NOTIFICATIONS_ENABLED=true
SUSPICIOUS_ACTIVITY_THRESHOLD=5
MAX_LOGIN_ATTEMPTS=3
ACCOUNT_LOCKOUT_DURATION=900000

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_BASE_URL=https://api.piptip.com
API_RATE_LIMIT_ENABLED=true

# API Tier Limits (requests per hour)
API_TIER_BASIC_LIMIT=1000
API_TIER_PREMIUM_LIMIT=10000
API_TIER_ENTERPRISE_LIMIT=100000

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/piptip/app.log
LOG_MAX_FILE_SIZE=100MB
LOG_MAX_FILES=10

# Performance Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_TIMEOUT=3000

# ============================================================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@piptip.com
SMTP_PASSWORD=your_email_password_here

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_ATTEMPTS=3

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ACHIEVEMENTS_ENABLED=true
LEADERBOARDS_ENABLED=true
PREDICTION_MARKETS_ENABLED=true
GROUP_TIPS_ENABLED=true
TIERED_MEMBERSHIPS_ENABLED=true

# ============================================================================
# BACKUP AND MAINTENANCE
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false