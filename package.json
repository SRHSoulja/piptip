{
  "name": "piptip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npx prisma generate && tsc && cp -r src/web/admin/js dist/web/admin/ && cp src/web/admin/ui.js dist/web/admin/ && cp -r src/web/static dist/web/ && cp -r src/web/server dist/web/ 2>/dev/null || true",
    "start": "npx prisma generate && node quick_sql_fix.cjs && node dist/index.js",
    "test": "tsx --test tests/*.test.js",
    "test:group-claim": "tsx --test tests/group-claim.test.js",
    "test:markets": "tsx scripts/test_markets.ts",
    "test:api": "tsx tests/api_integration_test.ts",
    "test:markets-full": "tsx scripts/test_markets.ts && tsx tests/api_integration_test.ts",
    "test:prediction-markets": "./test/test.sh",
    "test:comprehensive": "NODE_ENV=test tsx test/run_all_tests.ts",
    "test:automation": "NODE_ENV=test tsx -e \"import('./test/test_automation.js').then(m => m.runAutomationTests())\"",
    "test:cycle": "NODE_ENV=test tsx -e \"import('./test/test_full_cycle.js').then(m => m.runFullCycleTests())\"",
    "test:edge-cases": "NODE_ENV=test tsx -e \"import('./test/test_edge_cases.js').then(m => m.runEdgeCaseTests())\"",
    "test:load": "NODE_ENV=test tsx -e \"import('./test/test_load.js').then(m => m.runLoadTests())\"",
    "prisma:push": "prisma db push",
    "reset-data": "tsx src/scripts/safe-data-reset.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/express-session": "^1.18.2",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "bullmq": "^5.58.7",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^9.0.0",
    "decimal.js": "^10.6.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "ioredis": "^5.8.0",
    "nanoid": "^5.1.6",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4"
  }
}
