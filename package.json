{
  "name": "piptip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npx prisma generate && tsc && cp -r src/web/admin/js dist/web/admin/ && cp src/web/admin/ui.js dist/web/admin/ && cp -r src/web/static dist/web/ 2>/dev/null || true",
    "start": "npx prisma generate && node quick_sql_fix.cjs && node dist/index.js",
    "test": "tsx --test tests/*.test.js",
    "test:group-claim": "tsx --test tests/group-claim.test.js",
    "prisma:push": "prisma db push",
    "reset-data": "tsx src/scripts/safe-data-reset.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "ioredis": "^5.4.1",
    "pg": "^8.16.3",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "prisma": "^6.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
