generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String    @id @default(cuid())
  userId    Int
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("session")
}

model User {
  id                         Int                       @id @default(autoincrement())
  discordId                  String                    @unique
  agwAddress                 String?                   @unique
  wins                       Int                       @default(0)
  losses                     Int                       @default(0)
  ties                       Int                       @default(0)
  totalXP                    Int                       @default(0)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  bio                        String?
  bioLastUpdated             DateTime?
  bioViewCount               Int                       @default(0)
  xUsername                  String?
  socials                    String?
  allowTipsFromBook          Boolean                   @default(true)
  showInPenguBook            Boolean                   @default(true)
  isBanned                   Boolean                   @default(false)
  bannedAt                   DateTime?
  bannedReason               String?
  bannedByAdminId            String?
  lastAgeReminderShown       DateTime?
  predictionDailyCountLimit  Int?
  predictionDailyLossLimit   Int?
  predictionLimitsLastReset  DateTime?
  predictionSelfExcluded     Boolean                   @default(false)
  predictionSelfExclusionEnd DateTime?
  dailyStreak                Int                       @default(0)
  lastPipchipsDaily          DateTime?
  longestDailyStreak         Int                       @default(0)
  pipchipsBalance            BigInt                    @default(10000)
  pipchipsBoughtTotal        BigInt                    @default(0)
  pipchipsEarnedTotal        BigInt                    @default(0)
  pipchipsSpentTotal         BigInt                    @default(0)
  adminLevel                 Int                       @default(0)
  adminPromotedAt            DateTime?
  adminPromotedBy            String?
  canCreateMarkets           Boolean                   @default(false)
  isAdmin                    Boolean                   @default(false)
  isSuperUser                Boolean                   @default(false)
  activeTournamentId         String?
  inTournamentMode           Boolean                   @default(false)
  legacyAchievements         Achievement[]             @relation("LegacyAchievements")
  activityItems              ActivityFeedItem[]        @relation("ActivityUser")
  profileViewsReceived       BioBrowse[]               @relation("BioBrowseProfile")
  profileViewsGiven          BioBrowse[]               @relation("BioBrowseViewer")
  groupTipsCreated           GroupTip[]                @relation("GroupTipCreator")
  groupTipsClaimed           GroupTipClaim[]           @relation("GroupTipClaims")
  groupTipContributions      GroupTipContribution[]    @relation("GroupTipContributions")
  challenger                 Match[]                   @relation("Challenger")
  joiner                     Match[]                   @relation("Joiner")
  notifications              Notification[]
  penguBookMessagesSent      PenguBookMessage[]        @relation("PenguBookMessageSender")
  penguBookMessagesReceived  PenguBookMessage[]        @relation("PenguBookMessageReceiver")
  pipchipsPurchases          PipchipsPurchase[]
  pipchipsTransactions       PipchipsTransaction[]
  reactionsGiven             ProfileReaction[]         @relation("ReactionGiver")
  reactionsReceived          ProfileReaction[]         @relation("ReactionReceiver")
  referredBy                 Referral[]                @relation("UserReferred")
  referralsMade              Referral[]                @relation("UserReferrals")
  tierMemberships            TierMembership[]
  tipsSent                   Tip[]                     @relation("TipFrom")
  tipsReceived               Tip[]                     @relation("TipTo")
  tournamentParticipants     TournamentParticipant[]
  unlockedAchievements       UserAchievement[]         @relation("UserAchievements")
  achievementProgress        UserAchievementProgress[] @relation("UserProgressTracking")
  balances                   UserBalance[]
  following                  UserFollow[]              @relation("Follower")
  followers                  UserFollow[]              @relation("Following")
  stats                      UserStats?                @relation("UserToStats")
  streak                     UserStreak?               @relation("UserStreaks")
  withdrawalAttempts         WithdrawalAttempt[]
  xpTransactions             XpTransaction[]

  @@index([agwAddress])
  @@index([createdAt])
  @@index([showInPenguBook, bioLastUpdated])
  @@index([predictionSelfExcluded, predictionSelfExclusionEnd])
}

model Tier {
  id                    Int              @id @default(autoincrement())
  name                  String
  description           String?
  priceAmount           Decimal?
  durationDays          Int
  tipTaxFree            Boolean          @default(false)
  taxReductionBps       Int              @default(0)
  rakeReductionBps      Int              @default(0)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  canCreateMarkets      Boolean          @default(false)
  customRakePercent     Decimal?
  dailyMarketLimit      Int              @default(0)
  marketCooldownMinutes Int              @default(0)
  marketRakePercent     Decimal?         @default(3.0)
  systemLiquidityBonus  Int              @default(0)
  memberships           TierMembership[]
  prices                TierPrice[]      @relation("TierToPrices")

  @@index([active])
}

model TierPrice {
  id        Int      @id @default(autoincrement())
  tierId    Int
  tokenId   Int
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tier      Tier     @relation("TierToPrices", fields: [tierId], references: [id], onDelete: Cascade)
  token     Token    @relation("TokenToTierPrices", fields: [tokenId], references: [id])

  @@unique([tierId, tokenId])
  @@index([tokenId])
}

model TierMembership {
  id        Int                  @id @default(autoincrement())
  userId    Int
  tierId    Int
  startedAt DateTime             @default(now())
  expiresAt DateTime
  txHash    String?              @unique
  status    TierMembershipStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  tier      Tier                 @relation(fields: [tierId], references: [id])
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId, status], map: "uniq_user_tier_status")
  @@index([userId, tierId, expiresAt])
  @@index([userId, status, expiresAt])
}

model Match {
  id                      Int       @id @default(autoincrement())
  status                  String
  wagerAtomic             Decimal   @default(0)
  potAtomic               Decimal   @default(0)
  tokenId                 Int
  challengerId            Int?
  joinerId                Int?
  challengerMove          String?
  joinerMove              String?
  result                  String?
  rakeAtomic              Decimal   @default(0)
  winnerUserId            Int?
  messageId               String?
  channelId               String?
  offerDeadline           DateTime?
  createdAt               DateTime  @default(now())
  guildId                 String?
  challengerRoleBenefit   String?
  joinerRoleBenefit       String?
  challengerRakeReduction String?
  joinerRakeReduction     String?
  rakeSavedAtomic         Decimal   @default(0)
  Challenger              User?     @relation("Challenger", fields: [challengerId], references: [id])
  Joiner                  User?     @relation("Joiner", fields: [joinerId], references: [id])
  Token                   Token     @relation(fields: [tokenId], references: [id])

  @@index([status, offerDeadline])
  @@index([createdAt])
  @@index([challengerId])
  @@index([joinerId])
}

model Tip {
  id                  Int                @id @default(autoincrement())
  fromUserId          Int?
  toUserId            Int?
  tokenId             Int
  amountAtomic        Decimal            @default(0)
  feeAtomic           Decimal            @default(0)
  taxAtomic           Decimal            @default(0)
  note                String?
  status              TipStatus          @default(PENDING)
  refundedAt          DateTime?
  createdAt           DateTime           @default(now())
  roleBenefitUsed     String?
  taxSavedAtomic      Decimal            @default(0)
  guildId             String?
  taxRateAppliedBps   Int                @default(0)
  exemptionRateBps    Int                @default(0)
  totalDeductedAtomic Decimal            @default(0)
  penguBookMessages   PenguBookMessage[] @relation("PenguBookTipMessage")
  From                User?              @relation("TipFrom", fields: [fromUserId], references: [id])
  To                  User?              @relation("TipTo", fields: [toUserId], references: [id])
  Token               Token              @relation(fields: [tokenId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
  @@index([fromUserId, toUserId, status])
  @@index([status, createdAt])
}

model GroupTip {
  id                 Int                    @id @default(autoincrement())
  creatorId          Int?
  tokenId            Int
  totalAmount        Decimal
  taxAtomic          Decimal                @default(0)
  contributionsTotal Decimal                @default(0)
  contributorsCount  Int                    @default(0)
  duration           Int
  messageId          String?
  channelId          String?
  guildId            String?
  status             String
  expiresAt          DateTime
  refundedAt         DateTime?
  createdAt          DateTime               @default(now())
  Creator            User?                  @relation("GroupTipCreator", fields: [creatorId], references: [id])
  Token              Token                  @relation(fields: [tokenId], references: [id])
  claims             GroupTipClaim[]
  contributions      GroupTipContribution[]

  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([creatorId])
  @@index([guildId])
}

model GroupTipClaim {
  id         Int                     @id @default(autoincrement())
  groupTipId Int
  userId     Int?
  status     GroupContributionStatus @default(PENDING)
  claimedAt  DateTime?
  refundedAt DateTime?
  createdAt  DateTime                @default(now())
  GroupTip   GroupTip                @relation(fields: [groupTipId], references: [id])
  User       User?                   @relation("GroupTipClaims", fields: [userId], references: [id])

  @@unique([groupTipId, userId])
  @@index([status])
  @@index([groupTipId])
  @@index([userId])
}

model GroupTipContribution {
  id            Int      @id @default(autoincrement())
  groupTipId    Int
  contributorId Int
  amount        Decimal
  taxPaid       Decimal  @default(0)
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  contributor   User     @relation("GroupTipContributions", fields: [contributorId], references: [id], onDelete: Cascade)
  groupTip      GroupTip @relation(fields: [groupTipId], references: [id], onDelete: Cascade)

  @@unique([groupTipId, contributorId])
  @@index([groupTipId])
  @@index([contributorId])
  @@index([status])
}

model Token {
  id                 Int                 @id @default(autoincrement())
  address            String              @unique
  symbol             String              @unique
  decimals           Int
  active             Boolean             @default(true)
  minDeposit         Decimal             @default(50)
  minWithdraw        Decimal             @default(50)
  tipFeeBps          Int?
  houseFeeBps        Int?
  withdrawMaxPerTx   Decimal?
  withdrawDailyCap   Decimal?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  groupTips          GroupTip[]
  matches            Match[]
  tierPrices         TierPrice[]         @relation("TokenToTierPrices")
  tips               Tip[]
  transactions       Transaction[]
  balances           UserBalance[]
  withdrawalAttempts WithdrawalAttempt[]
}

model UserBalance {
  id      Int     @id @default(autoincrement())
  userId  Int
  tokenId Int
  amount  Decimal @default(0)
  Token   Token   @relation(fields: [tokenId], references: [id])
  User    User    @relation(fields: [userId], references: [id])

  @@unique([userId, tokenId])
}

model ProcessedDeposit {
  key       String   @id
  createdAt DateTime @default(now())
}

model DepositCursor {
  name      String   @id
  blockHex  String
  updatedAt DateTime @updatedAt
}

model AppConfig {
  id                            Int      @id @default(autoincrement())
  minDeposit                    Decimal  @default(50)
  minWithdraw                   Decimal  @default(50)
  withdrawMaxPerTx              Decimal  @default(50)
  withdrawDailyCap              Decimal  @default(500)
  houseFeeBps                   Int      @default(200)
  tipFeeBps                     Int      @default(100)
  emergencyMode                 Boolean  @default(false)
  withdrawalsPaused             Boolean  @default(false)
  tippingPaused                 Boolean  @default(false)
  achievementsEnabled           Boolean  @default(true)
  streakProtectionEnabled       Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  autoTransferEnabled           Boolean  @default(false)
  coldWalletAddress             String?
  treasuryCheckIntervalMins     Int      @default(60)
  treasuryMaxHoldingUSD         Decimal?
  treasuryMonitoringEnabled     Boolean  @default(false)
  treasuryWarningThresholdUSD   Decimal?
  referralEnabled               Boolean  @default(true)
  referralRakeReductionBps      Int      @default(50)
  referralRewardInterval        Int      @default(10)
  referralTaxReductionBps       Int      @default(50)
  referralVerificationThreshold Decimal  @default(20)
  referralWelcomeBonus          Decimal  @default(0)
}

model ApprovedServer {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuildSettings {
  id                  Int      @id @default(autoincrement())
  guildId             String   @unique
  channelMode         String   @default("ALLOW_ALL")
  allowedChannels     Json?
  blockedChannels     Json?
  tipChannels         Json?
  gameChannels        Json?
  announcementChannel String?
  perChannelCooldowns Json?
  featureRestrictions Json?
  autoSuggestChannels Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([guildId])
}

model ChannelActivity {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  commandType String
  commandName String
  userId      String
  timestamp   DateTime @default(now())
  success     Boolean  @default(true)

  @@index([guildId, channelId])
  @@index([guildId, timestamp])
  @@index([commandType])
}

model ServerApplication {
  id                   Int       @id @default(autoincrement())
  guildId              String    @unique
  guildName            String
  applicantId          String
  applicantTag         String
  contactInfo          String?
  serverSize           Int?
  description          String
  useCase              String
  status               String    @default("PENDING")
  reviewedBy           String?
  reviewNote           String?
  rejectionReason      String?
  submittedAt          DateTime  @default(now())
  reviewedAt           DateTime?
  applicantPermissions String?
  applicantRoles       String?
  isServerOwner        Boolean   @default(false)

  @@index([status])
  @@index([submittedAt])
  @@index([isServerOwner])
}

model Ad {
  id        Int      @id @default(autoincrement())
  text      String
  url       String?
  active    Boolean  @default(true)
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  userId      Int?
  otherUserId Int?
  guildId     String?
  tokenId     Int?
  amount      Decimal
  fee         Decimal  @default(0)
  txHash      String?
  metadata    String?
  createdAt   DateTime @default(now())
  priceSource String?
  usdFeeValue Decimal?
  usdPrice    Decimal?
  usdValue    Decimal?
  Token       Token?   @relation(fields: [tokenId], references: [id])

  @@index([createdAt])
  @@index([guildId])
  @@index([type])
  @@index([userId])
}

model XpTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  reason    String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model WebhookEvent {
  id        Int      @id @default(autoincrement())
  source    String
  key       String   @unique
  status    String
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BioBrowse {
  id        Int      @id @default(autoincrement())
  viewerId  Int
  profileId Int
  createdAt DateTime @default(now())
  profile   User     @relation("BioBrowseProfile", fields: [profileId], references: [id], onDelete: Cascade)
  viewer    User     @relation("BioBrowseViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId])
  @@index([profileId, createdAt])
  @@index([viewerId, createdAt])
}

model PenguBookMessage {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  tipId      Int?
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  from       User     @relation("PenguBookMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  tip        Tip?     @relation("PenguBookTipMessage", fields: [tipId], references: [id])
  to         User     @relation("PenguBookMessageReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, read, createdAt])
  @@index([fromUserId, createdAt])
}

model Referral {
  id                  Int       @id @default(autoincrement())
  referrerId          Int
  referredId          Int
  referralCode        String    @unique
  isVerified          Boolean   @default(false)
  verifiedAt          DateTime?
  totalTipped         Decimal   @default(0)
  createdAt           DateTime  @default(now())
  welcomeBonusGranted Boolean   @default(false)
  referred            User      @relation("UserReferred", fields: [referredId], references: [id], onDelete: Cascade)
  referrer            User      @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referrerId, isVerified])
  @@index([referredId])
  @@index([referralCode])
}

model UserStreak {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  currentWins Int       @default(0)
  longestWins Int       @default(0)
  lastGameAt  DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation("UserStreaks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currentWins])
  @@index([currentWins, lastGameAt])
  @@index([longestWins])
}

model AchievementDefinition {
  id                   Int                       @id @default(autoincrement())
  name                 String
  description          String
  category             String
  criteriaType         String
  criteriaData         Json
  threshold            Decimal
  iconEmoji            String
  badgeColor           String
  rarity               String
  isEnabled            Boolean                   @default(true)
  isVisible            Boolean                   @default(true)
  isRepeatable         Boolean                   @default(false)
  cooldownHours        Int?
  startDate            DateTime?
  endDate              DateTime?
  sortOrder            Int                       @default(0)
  tier                 Int                       @default(1)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdBy            String?
  version              Int                       @default(1)
  unlockedAchievements UserAchievement[]
  progressTracking     UserAchievementProgress[]

  @@index([category, isEnabled])
  @@index([isEnabled, isVisible, sortOrder])
  @@index([startDate, endDate])
}

model UserAchievement {
  id              Int                   @id @default(autoincrement())
  userId          Int
  definitionId    Int
  currentProgress Decimal               @default(0)
  targetProgress  Decimal
  unlockedAt      DateTime              @default(now())
  data            Json?
  lastUnlockedAt  DateTime?
  unlockCount     Int                   @default(1)
  definition      AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  user            User                  @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId])
  @@index([userId, unlockedAt])
  @@index([definitionId, unlockedAt])
  @@index([lastUnlockedAt])
}

model UserAchievementProgress {
  id              Int                   @id @default(autoincrement())
  userId          Int
  definitionId    Int
  currentProgress Decimal               @default(0)
  lastProgressAt  DateTime              @default(now())
  lastCheckedAt   DateTime              @default(now())
  progressData    Json?
  definition      AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  user            User                  @relation("UserProgressTracking", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId])
  @@index([userId, lastProgressAt])
  @@index([definitionId, currentProgress])
  @@index([lastCheckedAt])
}

model Achievement {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String
  level      Int
  unlockedAt DateTime @default(now())
  data       Json?
  user       User     @relation("LegacyAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, level])
  @@index([userId, type])
  @@index([type, level])
  @@index([unlockedAt])
  @@index([userId, unlockedAt])
}

model UserStats {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  totalTipsSent          Int       @default(0)
  totalTipsReceived      Int       @default(0)
  totalTipAmountSent     Decimal   @default(0)
  totalTipAmountReceived Decimal   @default(0)
  uniqueRecipients       Int       @default(0)
  uniqueSenders          Int       @default(0)
  totalDeposited         Decimal   @default(0)
  totalWithdrawn         Decimal   @default(0)
  matchesWon             Int       @default(0)
  matchesLost            Int       @default(0)
  matchesTied            Int       @default(0)
  achievementCount       Int       @default(0)
  lastTipAt              DateTime?
  lastMatchAt            DateTime?
  lastDepositAt          DateTime?
  updatedAt              DateTime  @updatedAt
  createdAt              DateTime  @default(now())
  user                   User      @relation("UserToStats", fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalTipsSent, updatedAt])
  @@index([matchesWon, updatedAt])
  @@index([totalDeposited, updatedAt])
  @@index([achievementCount, updatedAt])
  @@index([updatedAt])
}

model DailyStats {
  id                   Int      @id @default(autoincrement())
  date                 DateTime @unique @db.Date
  totalTips            Int      @default(0)
  totalTipVolume       Decimal  @default(0)
  totalDeposits        Int      @default(0)
  totalDepositVolume   Decimal  @default(0)
  totalMatches         Int      @default(0)
  newUsers             Int      @default(0)
  activeUsers          Int      @default(0)
  achievementsUnlocked Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([date])
}

model RoleTaxExemption {
  id             Int                    @id @default(autoincrement())
  roleId         String
  guildId        String
  exemptionRate  Decimal                @default(100.0) @db.Decimal(5, 2)
  duration       Int?
  label          String
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  expiresAt      DateTime?
  createdBy      String?
  notes          String?
  dailyAnalytics RoleBenefitAnalytics[] @relation("TaxAnalytics")

  @@unique([roleId, guildId])
  @@index([guildId, isActive])
  @@index([expiresAt])
}

model RoleRakeReduction {
  id               Int                    @id @default(autoincrement())
  roleId           String
  guildId          String
  rakeReductionBps Int                    @default(0)
  label            String
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  expiresAt        DateTime?
  createdBy        String?
  notes            String?
  dailyAnalytics   RoleBenefitAnalytics[] @relation("TaxAnalytics")

  @@unique([roleId, guildId])
  @@index([guildId, isActive])
  @@index([expiresAt])
}

model RoleBenefitAnalytics {
  id                       Int               @id @default(autoincrement())
  roleId                   String
  guildId                  String
  date                     DateTime          @db.Date
  tipsFromRoleHolders      Int               @default(0)
  tipsToRoleHolders        Int               @default(0)
  totalTipVolumeAtomic     Decimal           @default(0)
  totalTaxSavedAtomic      Decimal           @default(0)
  averageTipSizeAtomic     Decimal           @default(0)
  gamesPlayedByRoleHolders Int               @default(0)
  totalWageredAtomic       Decimal           @default(0)
  gamesWonByRoleHolders    Int               @default(0)
  totalRakeSavedAtomic     Decimal           @default(0)
  averageWagerSizeAtomic   Decimal           @default(0)
  activeRoleHolders        Int               @default(0)
  newRoleHoldersEngaged    Int               @default(0)
  returningRoleHolders     Int               @default(0)
  createdAt                DateTime          @default(now())
  rakeReduction            RoleRakeReduction @relation("RakeAnalytics", fields: [roleId, guildId], references: [roleId, guildId], map: "RoleBenefitAnalytics_rake_fkey")
  taxExemption             RoleTaxExemption  @relation("TaxAnalytics", fields: [roleId, guildId], references: [roleId, guildId], map: "RoleBenefitAnalytics_tax_fkey")

  @@unique([roleId, guildId, date])
  @@index([guildId, date])
  @@index([date])
}

model WithdrawalAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenId   Int
  amount    Decimal
  createdAt DateTime @default(now())
  blocked   Boolean  @default(false)
  reason    String?
  ipAddress String?
  userAgent String?
  token     Token    @relation(fields: [tokenId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, tokenId, createdAt])
}

model ProfileReaction {
  id           Int      @id @default(autoincrement())
  giverId      Int
  receiverId   Int
  reactionType String
  createdAt    DateTime @default(now())
  giver        User     @relation("ReactionGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver     User     @relation("ReactionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([giverId, receiverId, reactionType])
  @@index([receiverId, reactionType])
  @@index([giverId, createdAt])
}

model UserFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

model ActivityFeedItem {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       String
  data       Json
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  user       User     @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([visibility, createdAt])
}

model PredictionMarket {
  id                       String                    @id @default(cuid())
  title                    String
  description              String
  createdAt                DateTime                  @default(now())
  resolveAt                DateTime
  status                   String                    @default("ACTIVE")
  outcome                  String?
  totalYesBets             Int                       @default(0)
  totalNoBets              Int                       @default(0)
  totalBetCount            Int                       @default(0)
  rakePercentage           Float                     @default(3.0)
  minBet                   Int                       @default(1)
  maxBet                   Int                       @default(10000)
  creatorId                String
  guildId                  String
  channelId                String
  tokenSymbol              String
  marketType               String
  marketData               Json
  currentPrices            Json?
  liquidity                BigInt?                   @default(1000)
  lmsrShares               Json?
  marketOutcomes           String[]                  @default(["YES", "NO"])
  totalPipchipsVolume      BigInt?                   @default(0)
  adminNotes               String?
  isSpecialMarket          Boolean                   @default(false)
  requiresManualResolution Boolean                   @default(false)
  resolutionMethod         String                    @default("API_AUTO")
  resolvedAt               DateTime?
  resolvedBy               String?
  templateType             String?
  participations           PredictionParticipation[]

  @@index([guildId, status])
  @@index([status, resolveAt])
  @@index([creatorId, createdAt])
}

model PredictionParticipation {
  id              String           @id @default(cuid())
  marketId        String
  userId          String
  side            String
  amount          Int
  tokenSymbol     String
  sharesPurchased Decimal?         @db.Decimal(20, 8)
  createdAt       DateTime         @default(now())
  market          PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, side])
  @@index([userId, createdAt])
  @@index([marketId, userId])
}

model AutoMarketLog {
  id                String   @id
  marketId          String?
  type              String
  subtype           String
  success           Boolean
  error             String?
  config            Json
  guildId           String?
  engagementMetrics Json?
  createdAt         DateTime @default(now())

  @@index([type, createdAt])
  @@index([success, createdAt])
  @@index([guildId, createdAt])
}

model Payout {
  id             String    @id @default(cuid())
  marketId       String
  idempotencyKey String    @unique
  totalAmount    String
  winningShares  String
  status         String    @default("PENDING")
  payoutCount    Int?
  actualTotal    String?
  processedAt    DateTime  @default(now())
  completedAt    DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([marketId, status])
  @@index([idempotencyKey])
  @@index([status, processedAt])
}

model DeadLetterJob {
  id                   String   @id @default(cuid())
  originalQueue        String
  originalJobId        String
  originalPayload      Json
  failureReason        String
  attempts             Int
  lastError            Json
  canRetry             Boolean  @default(false)
  requiresManualReview Boolean  @default(true)
  escalationLevel      String
  estimatedResolution  String?
  status               String   @default("PENDING")
  reviewedBy           String?
  dismissalReason      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, escalationLevel])
  @@index([originalQueue, createdAt])
  @@index([createdAt])
  @@index([requiresManualReview, status])
}

model ReconciliationResult {
  id                String   @id @default(cuid())
  type              String
  status            String
  scope             Json
  driftsFound       Int      @default(0)
  correctionsMade   Int      @default(0)
  toleranceExceeded Int      @default(0)
  details           Json
  createdAt         DateTime @default(now())

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([type, status])
}

model OutboxMessage {
  id            String       @id @default(cuid())
  aggregateId   String
  aggregateType String
  eventType     String
  channelId     String?
  userId        String?
  guildId       String?
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  lastError     String?
  nextRetryAt   DateTime     @default(now())
  messageHash   String       @unique
  priority      Int          @default(5)
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, nextRetryAt])
  @@index([aggregateId, eventType])
  @@index([status, priority])
  @@index([createdAt])
}

model PipchipsPackage {
  id              String             @id @default(cuid())
  name            String
  pipchipsAmount  BigInt
  usdPrice        Decimal            @db.Decimal(10, 2)
  bonusText       String?
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  bonusPercentage Int                @default(0)
  tokenCost       Decimal            @default(0) @db.Decimal(20, 8)
  tokenSymbol     String             @default("PENGU")
  purchases       PipchipsPurchase[]

  @@index([isActive, displayOrder])
}

model PipchipsPurchase {
  id              String          @id @default(cuid())
  userId          String
  packageId       String
  pipchipsAmount  BigInt
  usdPrice        Decimal         @db.Decimal(10, 2)
  paymentTokenId  String
  paymentAmount   String
  tokenPriceUsd   Decimal         @db.Decimal(18, 8)
  transactionHash String?
  status          PurchaseStatus  @default(PENDING)
  createdAt       DateTime        @default(now())
  processedAt     DateTime?
  package         PipchipsPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [discordId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PipchipsTransaction {
  id              String                  @id @default(cuid())
  userId          String
  amount          BigInt
  transactionType PipchipsTransactionType
  referenceId     String?
  balanceAfter    BigInt
  description     String?
  metadata        Json?
  createdAt       DateTime                @default(now())
  user            User                    @relation(fields: [userId], references: [discordId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([transactionType, createdAt])
  @@index([referenceId])
}

model AdminSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([updatedAt])
}

model TournamentSession {
  id                String                  @id @default(cuid())
  name              String
  description       String?
  entryFeeUSD       Decimal
  startTime         DateTime
  endTime           DateTime
  status            String                  @default("UPCOMING")
  minPlayers        Int                     @default(10)
  maxPlayers        Int?
  prizeTokens       Json
  prizeDistribution Json
  startingPIPChips  Int                     @default(10000)
  allowLatecomer    Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  createdBy         String?
  participants      TournamentParticipant[]

  @@index([status, startTime])
  @@index([startTime, endTime])
}

model TournamentParticipant {
  id                 String            @id @default(cuid())
  tournamentId       String
  userId             Int
  pipchipsStart      Int               @default(10000)
  pipchipsBalance    Int               @default(10000)
  marketsPlayed      Int               @default(0)
  correctPredictions Int               @default(0)
  totalWagered       Int               @default(0)
  profitLoss         Int?
  rank               Int?
  prizesWon          Json?
  entryTokenId       Int?
  entryAmount        Decimal?
  enteredAt          DateTime          @default(now())
  tournament         TournamentSession @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([tournamentId, pipchipsBalance])
  @@index([tournamentId, rank])
}

enum TierMembershipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum TipStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum GroupTipStatus {
  PENDING
  ACTIVE
  EXPIRED
  REFUNDED
  FAILED
}

enum GroupContributionStatus {
  PENDING
  CLAIMED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DLQ
}

enum PurchaseStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PipchipsTransactionType {
  DAILY_BONUS
  STREAK_BONUS
  PURCHASE
  BET_PLACED
  BET_WON
  BET_REFUNDED
  TOURNAMENT_PRIZE
  ADMIN_CREDIT
  ADMIN_DEBIT
  REFERRAL_BONUS
  STARTING_BONUS
  PREDICTION_BET
  PREDICTION_WIN
  PREDICTION_LOSS
  TOURNAMENT_ENTRY
  TOURNAMENT_BET
  TOURNAMENT_WIN
}
