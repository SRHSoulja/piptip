datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Notification {
  id        String    @id @default(cuid())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId, sentAt])
}

model User {
  id         Int      @id @default(autoincrement())
  discordId  String   @unique
  agwAddress String?  @unique // SECURITY: Prevent multiple Discord users linking same wallet
  wins       Int      @default(0) // SECURITY: Prevent negative values
  losses     Int      @default(0) // SECURITY: Prevent negative values
  ties       Int      @default(0) // SECURITY: Prevent negative values
  totalXP    Int      @default(0) // Penguin XP progression system
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // SECURITY: Database constraints to prevent impossible states (enforced at DB level)

  // Gaming relations
  challenger Match[] @relation("Challenger")
  joiner     Match[] @relation("Joiner")

  // Tipping relations
  tipsSent     Tip[] @relation("TipFrom")
  tipsReceived Tip[] @relation("TipTo")

  // Group tipping relations
  groupTipsCreated     GroupTip[]             @relation("GroupTipCreator")
  groupTipsClaimed     GroupTipClaim[]        @relation("GroupTipClaims")
  groupTipContributions GroupTipContribution[] @relation("GroupTipContributions")

  // Balances
  balances UserBalance[]

  // Memberships (BACK-RELATION added)
  tierMemberships TierMembership[]

  // Notifications
  notifications Notification[]

  // Security: Withdrawal attempt tracking
  withdrawalAttempts WithdrawalAttempt[]

  // PenguBook profile fields
  bio               String?   @db.Text
  bioLastUpdated    DateTime?
  bioViewCount      Int       @default(0)
  xUsername         String?   // X/Twitter handle (without @)
  socials           String?   @db.Text // JSON string for social links
  allowTipsFromBook Boolean   @default(true)
  showInPenguBook   Boolean   @default(true)

  // Ban system fields
  isBanned          Boolean   @default(false)
  bannedAt          DateTime?
  bannedReason      String?
  bannedByAdminId   String?

  // PenguBook browsing relations
  profileViewsGiven    BioBrowse[] @relation("BioBrowseViewer")
  profileViewsReceived BioBrowse[] @relation("BioBrowseProfile")

  // PenguBook messaging relations
  penguBookMessagesSent     PenguBookMessage[] @relation("PenguBookMessageSender")
  penguBookMessagesReceived PenguBookMessage[] @relation("PenguBookMessageReceiver")

  // Referral system relations
  referralsMade     Referral[] @relation("UserReferrals")
  referredBy        Referral[] @relation("UserReferred")

  // XP tracking relations
  xpTransactions XpTransaction[]

  // Streak and achievement relations
  streak       UserStreak? @relation("UserStreaks")

  // Dynamic achievement system
  unlockedAchievements UserAchievement[] @relation("UserAchievements")
  achievementProgress  UserAchievementProgress[] @relation("UserProgressTracking")

  // Legacy achievements (deprecated)
  legacyAchievements Achievement[] @relation("LegacyAchievements")

  stats        UserStats? @relation("UserToStats")

  @@index([agwAddress])
  @@index([createdAt])
  @@index([showInPenguBook, bioLastUpdated])
}

model Tier {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?  @db.Text
  priceAmount  Decimal? // legacy/optional
  durationDays Int

  // Flexible benefit system (replaces tipTaxFree boolean)
  tipTaxFree   Boolean  @default(false) // DEPRECATED - keep for backward compatibility
  taxReductionBps Int   @default(0)     // NEW: 0-10000 basis points (100% = 10000)
  rakeReductionBps Int  @default(0)     // NEW: 0-10000 basis points (100% = 10000)

  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships TierMembership[]

  // ✅ back-relation to TierPrice
  prices TierPrice[] @relation("TierToPrices")

  @@index([active])
}

model TierPrice {
  id        Int      @id @default(autoincrement())
  tierId    Int
  tokenId   Int
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ name both sides of the relation
  tier  Tier  @relation("TierToPrices", fields: [tierId], references: [id], onDelete: Cascade)
  token Token @relation("TokenToTierPrices", fields: [tokenId], references: [id], onDelete: Restrict)

  @@unique([tierId, tokenId])
  @@index([tokenId])
}

enum TierMembershipStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model TierMembership {
  id        Int                  @id @default(autoincrement())
  userId    Int
  tierId    Int
  startedAt DateTime             @default(now())
  expiresAt DateTime
  txHash    String?              @unique
  status    TierMembershipStatus @default(ACTIVE)
  createdAt DateTime             @default(now())

  // BACK-RELATIONS now have opposites on User and Tier
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier Tier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([userId, tierId, status], map: "uniq_user_tier_status") // one ACTIVE membership per (user,tier)
  @@index([userId, tierId, expiresAt])
  @@index([userId, status, expiresAt])
  // SECURITY: Prevent impossible date relationships (enforced at DB level)
}

model Match {
  id             Int       @id @default(autoincrement())
  status         String
  wagerAtomic    Decimal   @default(0)
  potAtomic      Decimal   @default(0)
  tokenId        Int
  challengerId   Int?
  joinerId       Int?
  challengerMove String?
  joinerMove     String?
  result         String?
  rakeAtomic     Decimal   @default(0)
  winnerUserId   Int?
  messageId      String?
  channelId      String?
  offerDeadline  DateTime?
  createdAt      DateTime  @default(now())

  // Role analytics tracking
  guildId              String? // Server where match occurred
  challengerRoleBenefit String? // Role that gave challenger tax benefits
  joinerRoleBenefit    String? // Role that gave joiner tax benefits
  challengerRakeReduction String? // Role that gave challenger rake benefits
  joinerRakeReduction  String? // Role that gave joiner rake benefits
  rakeSavedAtomic      Decimal @default(0) // Total rake saved due to role benefits

  Challenger User? @relation("Challenger", fields: [challengerId], references: [id])
  Joiner     User? @relation("Joiner", fields: [joinerId], references: [id])
  Token      Token @relation(fields: [tokenId], references: [id])

  @@index([status, offerDeadline])
  @@index([createdAt])
  @@index([challengerId])
  @@index([joinerId])
}

enum TipStatus {
  PENDING
  COMPLETED
  REFUNDED
}

model Tip {
  id           Int       @id @default(autoincrement())
  fromUserId   Int?
  toUserId     Int?
  tokenId      Int
  amountAtomic Decimal   @default(0)
  feeAtomic    Decimal   @default(0)
  taxAtomic    Decimal   @default(0) // exact tax amount debited at creation
  note         String?
  status       TipStatus @default(PENDING)
  refundedAt   DateTime?
  createdAt    DateTime  @default(now())

  // Role analytics tracking
  roleBenefitUsed String? // Label of role that provided tax benefit
  taxSavedAtomic  Decimal @default(0) // Amount saved due to role benefit
  guildId         String? // Server where tip occurred (for role context)

  // Tax transparency fields (NEW)
  taxRateAppliedBps Int   @default(0)   // Actual tax rate used (BPS) - preserves historical rates
  exemptionRateBps  Int   @default(0)   // Percentage reduction applied (BPS) - 0-10000
  totalDeductedAtomic Decimal @default(0) // Total amount deducted from sender (amount + tax)

  From  User?  @relation("TipFrom", fields: [fromUserId], references: [id])
  To    User?  @relation("TipTo", fields: [toUserId], references: [id])
  Token Token @relation(fields: [tokenId], references: [id])

  // PenguBook message relation
  penguBookMessages PenguBookMessage[] @relation("PenguBookTipMessage")

  @@index([createdAt])
  @@index([status])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, status]) // For tip counting queries in achievements
  @@index([toUserId, status]) // For received tip queries
  @@index([fromUserId, toUserId, status]) // For unique recipient queries
  @@index([status, createdAt]) // For completed tips with date sorting
}

enum GroupTipStatus {
  PENDING
  ACTIVE
  EXPIRED
  REFUNDED
  FAILED
}

model GroupTip {
  id          Int      @id @default(autoincrement())
  creatorId   Int?
  tokenId     Int
  totalAmount        Decimal
  taxAtomic          Decimal  @default(0) // exact tax amount debited at creation
  contributionsTotal Decimal  @default(0) // total amount contributed by others
  contributorsCount  Int      @default(0) // number of contributors
  duration           Int
  messageId   String?
  channelId   String?
  guildId     String?
  status      String   // Keep as String for backward compatibility
  expiresAt   DateTime
  refundedAt  DateTime?
  createdAt   DateTime @default(now())

  Creator       User?                   @relation("GroupTipCreator", fields: [creatorId], references: [id])
  Token         Token                   @relation(fields: [tokenId], references: [id])
  claims        GroupTipClaim[]
  contributions GroupTipContribution[]

  @@index([status, expiresAt])
  @@index([createdAt])
  @@index([creatorId])
  @@index([guildId])
}

enum GroupContributionStatus {
  PENDING
  CLAIMED
  REFUNDED
}

model GroupTipClaim {
  id         Int                      @id @default(autoincrement())
  groupTipId Int
  userId     Int?
  status     GroupContributionStatus  @default(PENDING)
  claimedAt  DateTime?
  refundedAt DateTime?
  createdAt  DateTime                 @default(now())

  GroupTip GroupTip @relation(fields: [groupTipId], references: [id])
  User     User?    @relation("GroupTipClaims", fields: [userId], references: [id])

  @@unique([groupTipId, userId])
  @@index([status])
  @@index([groupTipId])
  @@index([userId])
}

model GroupTipContribution {
  id            Int      @id @default(autoincrement())
  groupTipId    Int
  contributorId Int
  amount        Decimal
  taxPaid       Decimal  @default(0)
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())

  groupTip    GroupTip @relation(fields: [groupTipId], references: [id], onDelete: Cascade)
  contributor User     @relation("GroupTipContributions", fields: [contributorId], references: [id], onDelete: Cascade)

  @@unique([groupTipId, contributorId])
  @@index([groupTipId])
  @@index([contributorId])
  @@index([status])
}

model Token {
  id               Int      @id @default(autoincrement())
  address          String   @unique
  symbol           String   @unique
  decimals         Int
  active           Boolean  @default(true)
  minDeposit       Decimal  @default(50)
  minWithdraw      Decimal  @default(50)
  tipFeeBps        Int?
  houseFeeBps      Int?
  withdrawMaxPerTx Decimal?
  withdrawDailyCap Decimal?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  balances     UserBalance[]
  matches      Match[]
  tips         Tip[]
  groupTips    GroupTip[]
  transactions Transaction[]

  // Security: Withdrawal attempt tracking
  withdrawalAttempts WithdrawalAttempt[]

  // ✅ back-relation to TierPrice
  tierPrices TierPrice[] @relation("TokenToTierPrices")
}

model UserBalance {
  id      Int     @id @default(autoincrement())
  userId  Int
  tokenId Int
  amount  Decimal @default(0) // SECURITY: Must be non-negative

  User  User  @relation(fields: [userId], references: [id])
  Token Token @relation(fields: [tokenId], references: [id])

  @@unique([userId, tokenId])
  // SECURITY: Prevent negative balances at database level (enforced at DB level)
}

model ProcessedDeposit {
  key       String   @id
  createdAt DateTime @default(now())
}

model DepositCursor {
  name      String   @id
  blockHex  String
  updatedAt DateTime @updatedAt
}

model AppConfig {
  id               Int      @id @default(autoincrement())
  minDeposit       Decimal  @default(50)
  minWithdraw      Decimal  @default(50)
  withdrawMaxPerTx Decimal  @default(50)
  withdrawDailyCap Decimal  @default(500)
  houseFeeBps      Int      @default(200)
  tipFeeBps        Int      @default(100)
  emergencyMode    Boolean  @default(false)
  withdrawalsPaused Boolean @default(false)
  tippingPaused    Boolean  @default(false)
  achievementsEnabled Boolean @default(true)
  streakProtectionEnabled Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ApprovedServer {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique
  note      String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ad {
  id        Int      @id @default(autoincrement())
  text      String
  url       String?
  active    Boolean  @default(true)
  weight    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        String
  userId      Int?
  otherUserId Int?
  guildId     String?
  tokenId     Int?
  amount      Decimal
  fee         Decimal  @default(0)
  txHash      String?
  metadata    String?
  createdAt   DateTime @default(now())

  Token Token? @relation(fields: [tokenId], references: [id])

  @@index([createdAt])
  @@index([guildId])
  @@index([type])
  @@index([userId])
}

model XpTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int      // XP amount (can be negative for penalties)
  reason    String   // Reason for XP change (e.g., "tip_sent", "achievement_unlocked")
  metadata  String?  // Additional context as JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model WebhookEvent {
  id        Int      @id @default(autoincrement())
  source    String
  key       String   @unique
  status    String
  payload   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// PenguBook browsing history - track who viewed whose profile
model BioBrowse {
  id        Int      @id @default(autoincrement())
  viewerId  Int      // who viewed the profile
  profileId Int      // whose profile was viewed
  createdAt DateTime @default(now())
  
  viewer  User @relation("BioBrowseViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profile User @relation("BioBrowseProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([viewerId, profileId]) // prevent duplicate views from same user
  @@index([profileId, createdAt]) // for getting recent viewers
  @@index([viewerId, createdAt])  // for user's browsing history
}

// PenguBook messages - direct messages sent with tips from PenguBook
model PenguBookMessage {
  id        Int      @id @default(autoincrement())
  fromUserId Int     // sender
  toUserId   Int     // recipient  
  tipId      Int?    // link to tip if it was a tip message
  message    String  @db.Text
  read       Boolean @default(false)
  createdAt  DateTime @default(now())
  
  from User @relation("PenguBookMessageSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("PenguBookMessageReceiver", fields: [toUserId], references: [id], onDelete: Cascade)
  tip  Tip? @relation("PenguBookTipMessage", fields: [tipId], references: [id], onDelete: SetNull)
  
  @@index([toUserId, read, createdAt]) // for inbox queries
  @@index([fromUserId, createdAt])     // for sent messages
}

model Referral {
  id            Int      @id @default(autoincrement())
  referrerId    Int      // User who made the referral
  referredId    Int      // User who was referred
  referralCode  String   @unique // Unique code for tracking
  isVerified    Boolean  @default(false) // True when referred user has tipped >= 20 tokens
  verifiedAt    DateTime?
  totalTipped   Decimal  @default(0) // Track total tipped by referred user
  createdAt     DateTime @default(now())

  referrer User @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("UserReferred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId]) // Prevent duplicate referrals
  @@index([referrerId, isVerified])
  @@index([referredId])
  @@index([referralCode])
}

model UserStreak {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  currentWins  Int      @default(0)
  longestWins  Int      @default(0)
  lastGameAt   DateTime?
  updatedAt    DateTime @updatedAt

  user User @relation("UserStreaks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currentWins])
  @@index([currentWins, lastGameAt]) // For leaderboard queries
  @@index([longestWins]) // For longest streak leaderboards
}

// Dynamic Achievement System Models

model AchievementDefinition {
  id                Int      @id @default(autoincrement())
  name              String   // Display name: "First Win Streak"
  description       String   // "Win 3 matches in a row"
  category          String   // "streaks", "tips", "deposits", "referrals"

  // Criteria configuration
  criteriaType      String   // "count", "sum", "streak", "unique", "custom"
  criteriaData      Json     // Flexible criteria configuration
  threshold         Decimal  // Target value to achieve

  // Display properties
  iconEmoji         String   // "🔥", "💰", "🏆"
  badgeColor        String   // Hex color for badge
  rarity           String    // "common", "rare", "epic", "legendary"

  // Configuration
  isEnabled         Boolean  @default(true)
  isVisible         Boolean  @default(true)  // Show in UI even if not unlocked
  isRepeatable      Boolean  @default(false) // Can be earned multiple times

  // Time-gating
  cooldownHours     Int?     // Hours between unlocks (for repeatable)
  startDate         DateTime? // When achievement becomes available
  endDate           DateTime? // When achievement expires

  // Ordering and organization
  sortOrder         Int      @default(0)
  tier              Int      @default(1) // Difficulty tier (1-5)

  // Metadata
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdBy         String?  // Admin who created it
  version           Int      @default(1) // For tracking changes

  // Relations
  unlockedAchievements UserAchievement[]
  progressTracking     UserAchievementProgress[]

  @@index([category, isEnabled])
  @@index([isEnabled, isVisible, sortOrder])
  @@index([startDate, endDate])
}

model UserAchievement {
  id               Int      @id @default(autoincrement())
  userId           Int
  definitionId     Int

  // Progress tracking
  currentProgress  Decimal  @default(0)
  targetProgress   Decimal  // Snapshot of threshold when unlocked

  // Unlock details
  unlockedAt       DateTime @default(now())
  data             Json?    // Extra data about the unlock

  // Time-gating tracking
  lastUnlockedAt   DateTime? // For repeatable achievements
  unlockCount      Int      @default(1) // How many times earned

  // Relations
  user       User @relation("UserAchievements", fields: [userId], references: [id], onDelete: Cascade)
  definition AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId]) // One achievement per user (for non-repeatable)
  @@index([userId, unlockedAt])
  @@index([definitionId, unlockedAt])
  @@index([lastUnlockedAt]) // For cooldown checks
}

model UserAchievementProgress {
  id               Int      @id @default(autoincrement())
  userId           Int
  definitionId     Int

  // Progress tracking
  currentProgress  Decimal  @default(0)
  lastProgressAt   DateTime @default(now())

  // Efficiency fields
  lastCheckedAt    DateTime @default(now())
  progressData     Json?    // Store intermediate calculations

  // Relations
  user       User @relation("UserProgressTracking", fields: [userId], references: [id], onDelete: Cascade)
  definition AchievementDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([userId, definitionId])
  @@index([userId, lastProgressAt])
  @@index([definitionId, currentProgress])
  @@index([lastCheckedAt]) // For batch processing
}

// Legacy Achievement model (keeping for migration compatibility)
model Achievement {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String   // "win_streak", "referral_count", "total_tips", etc.
  level       Int      // Achievement level/tier
  unlockedAt  DateTime @default(now())
  data        Json?    // Extra achievement data

  user User @relation("LegacyAchievements", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, level]) // Prevent duplicate achievements
  @@index([userId, type])
  @@index([type, level]) // For achievement statistics queries
  @@index([unlockedAt]) // For recent achievements and sorting
  @@index([userId, unlockedAt]) // For user achievement history
}

// Aggregate table for user statistics (updated via triggers/background jobs)
model UserStats {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique
  totalTipsSent         Int      @default(0)
  totalTipsReceived     Int      @default(0)
  totalTipAmountSent    Decimal  @default(0)
  totalTipAmountReceived Decimal @default(0)
  uniqueRecipients      Int      @default(0)
  uniqueSenders         Int      @default(0)
  totalDeposited        Decimal  @default(0)
  totalWithdrawn        Decimal  @default(0)
  matchesWon            Int      @default(0)
  matchesLost           Int      @default(0)
  matchesTied           Int      @default(0)
  achievementCount      Int      @default(0)
  lastTipAt             DateTime?
  lastMatchAt           DateTime?
  lastDepositAt         DateTime?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  user User @relation("UserToStats", fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalTipsSent, updatedAt]) // For tip leaderboards
  @@index([matchesWon, updatedAt]) // For match leaderboards
  @@index([totalDeposited, updatedAt]) // For deposit leaderboards
  @@index([achievementCount, updatedAt]) // For achievement leaderboards
  @@index([updatedAt]) // For finding stale records
}

// Daily aggregates for leaderboards and analytics
model DailyStats {
  id                 Int      @id @default(autoincrement())
  date               DateTime @unique @db.Date
  totalTips          Int      @default(0)
  totalTipVolume     Decimal  @default(0)
  totalDeposits      Int      @default(0)
  totalDepositVolume Decimal  @default(0)
  totalMatches       Int      @default(0)
  newUsers           Int      @default(0)
  activeUsers        Int      @default(0)
  achievementsUnlocked Int    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
}

// Discord role-based tax exemptions for NFT holders and partners
model RoleTaxExemption {
  id            Int      @id @default(autoincrement())
  roleId        String   // Discord role ID
  guildId       String   // Discord server ID
  exemptionRate Decimal  @default(100.0) @db.Decimal(5,2) // 0-100% tax reduction
  duration      Int?     // Days until expiry (null = permanent)
  label         String   // "NFT Holder", "VIP", "Partner", etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime? // Calculated expiry date

  // Admin tracking
  createdBy     String?  // Admin who created this exemption
  notes         String?  // Internal notes about partnership

  // Analytics relations
  dailyAnalytics RoleBenefitAnalytics[] @relation("TaxAnalytics")

  @@unique([roleId, guildId])
  @@index([guildId, isActive])
  // SECURITY: Prevent invalid exemption rates (enforced at DB level)
  @@index([expiresAt])
}

// Discord role-based rake reductions for gaming benefits
model RoleRakeReduction {
  id              Int      @id @default(autoincrement())
  roleId          String   // Discord role ID
  guildId         String   // Discord server ID
  rakeReductionBps Int     @default(0) // Basis points (5000 = 50% reduction)
  label           String   // "NFT Holder", "VIP", "Partner", etc.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // Calculated expiry date

  // Admin tracking
  createdBy       String?  // Admin who created this reduction
  notes           String?  // Internal notes about partnership

  // Analytics relations
  dailyAnalytics RoleBenefitAnalytics[] @relation("RakeAnalytics")

  @@unique([roleId, guildId]) // One reduction per role per server
  @@index([guildId, isActive])
  @@index([expiresAt])
  // SECURITY: Prevent invalid rake reduction rates (BPS: 0-10000 = 0-100%) (enforced at DB level)
}

// Daily analytics for role-based benefits (for partnership reports)
model RoleBenefitAnalytics {
  id              Int      @id @default(autoincrement())
  roleId          String   // Discord role ID
  guildId         String   // Discord server ID
  date            DateTime @db.Date // Analytics date (daily aggregation)

  // Tip metrics (tax benefits)
  tipsFromRoleHolders    Int     @default(0) // Tips sent by role holders
  tipsToRoleHolders      Int     @default(0) // Tips received by role holders
  totalTipVolumeAtomic   Decimal @default(0) // Volume tipped by role holders
  totalTaxSavedAtomic    Decimal @default(0) // Total tax savings provided
  averageTipSizeAtomic   Decimal @default(0) // Average tip size from role holders

  // Gaming metrics (rake benefits)
  gamesPlayedByRoleHolders Int     @default(0) // Games played by role holders
  totalWageredAtomic       Decimal @default(0) // Volume wagered by role holders
  gamesWonByRoleHolders    Int     @default(0) // Games won by role holders
  totalRakeSavedAtomic     Decimal @default(0) // Total rake savings provided (NEW)
  averageWagerSizeAtomic   Decimal @default(0) // Average wager size from role holders (NEW)

  // Engagement metrics
  activeRoleHolders       Int @default(0) // Unique role holders who tipped/gamed today
  newRoleHoldersEngaged   Int @default(0) // First-time role holders who engaged

  // Retention metrics
  returningRoleHolders    Int @default(0) // Role holders who engaged yesterday & today

  createdAt DateTime @default(now())

  // Relations (flexible - can be tax OR rake exemption)
  taxExemption  RoleTaxExemption?  @relation("TaxAnalytics", fields: [roleId, guildId], references: [roleId, guildId], map: "RoleBenefitAnalytics_tax_fkey")
  rakeReduction RoleRakeReduction? @relation("RakeAnalytics", fields: [roleId, guildId], references: [roleId, guildId], map: "RoleBenefitAnalytics_rake_fkey")

  @@unique([roleId, guildId, date]) // One record per role per day
  @@index([guildId, date]) // Query by server and time range
  @@index([date]) // Global analytics by date
}

// SECURITY: Database model for persistent withdrawal attempt tracking
model WithdrawalAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int      // User.id
  tokenId     Int      // Token.id
  amount      Decimal  // Amount attempted
  createdAt   DateTime @default(now())
  blocked     Boolean  @default(false) // Was this attempt blocked?
  reason      String?  // Why blocked (rate limit, cooldown, etc.)
  ipAddress   String?  // IP tracking for advanced abuse detection
  userAgent   String?  // Browser fingerprinting

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  token       Token    @relation(fields: [tokenId], references: [id])

  @@index([userId, createdAt]) // Fast lookup for user's recent attempts
  @@index([userId, tokenId, createdAt]) // Per-token attempt tracking
}