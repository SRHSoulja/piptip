# PIPTip Environment Configuration Template
# Copy this file to .env and fill in your values

# Discord Configuration (REQUIRED)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_app_id_here
DISCORD_CLIENT_ID=your_discord_app_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=https://piptip.replit.app/auth/discord/callback
GUILD_ID=your_primary_guild_id_here

# Discord Webhook for Monitoring Alerts (OPTIONAL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Database Configuration (REQUIRED)
# For production with Supabase PgBouncer:
DATABASE_URL="postgresql://user:pass@host:port/database?pgbouncer=true&pool_size=15&connection_limit=20"

# Test Database Configuration (REQUIRED for tests - complete isolation from production)
# IMPORTANT: All tests run against a dedicated test database on port 5433 (not 5432)
# This prevents production database access, schema conflicts, and data corruption
#
# Quick Setup:
# 1. Run: npm run test:setup
# 2. This starts PostgreSQL on port 5433 and runs migrations
# 3. Tests will automatically use this database via .env.test
#
# For production/cloud test database:
TEST_DATABASE_URL="postgresql://user:pass@host:port/piptip_test?pgbouncer=true&pool_size=15&connection_limit=20"
#
# For local Docker test database (recommended):
# TEST_DATABASE_URL="postgresql://piptip_test:test_password@localhost:5433/piptip_test?schema=public"

# Network Configuration (NEW: Auto-switches between mainnet/testnet)
NETWORK=mainnet
# Options: "mainnet" or "testnet" (defaults to mainnet if not set)

# Mainnet Configuration (REQUIRED)
MAINNET_RPC_URL=https://abstract-mainnet.g.alchemy.com/v2/YourAlchemyKeyHere
MAINNET_CHAIN_ID=2741

# Testnet Configuration (REQUIRED)
TESTNET_RPC_URL=https://api.testnet.abs.xyz
TESTNET_CHAIN_ID=11124

# Legacy (DEPRECATED - will be auto-resolved based on NETWORK)
# ABSTRACT_RPC_URL=https://abstract-mainnet.g.alchemy.com/v2/YourAlchemyKeyHere
# ABSTRACT_CHAIN_ID=2741
TREASURY_AGW_ADDRESS=0xYourTreasuryAddressHere
AGW_SESSION_PRIVATE_KEY=your_private_key_here

# Merkle Registry Contracts (REQUIRED for snapshot publishing)
MAINNET_REGISTRY_CONTRACT_ADDRESS=0xYourMainnetRegistryContractHere
TESTNET_REGISTRY_CONTRACT_ADDRESS=0xYourTestnetRegistryContractHere

# Token Contract Addresses (REQUIRED)
TOKEN_ADDRESS=0xYourMainTokenAddressHere
PENGUIN_TOKEN_ADDRESS=0xYourPenguinTokenAddressHere
ICE_TOKEN_ADDRESS=0xYourIceTokenAddressHere
PEBBLE_TOKEN_ADDRESS=0xYourPebbleTokenAddressHere

# Token Configuration
TOKEN_DECIMALS=18

# Fee Configuration (basis points)
HOUSE_FEE_BPS=200
TIP_FEE_BPS=100
WITHDRAWAL_FEE_BASIS_POINTS=25
TIP_TAX_BASIS_POINTS=50
GROUP_TIP_TAX_BASIS_POINTS=100

# Application Configuration
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change_this_to_a_secure_random_string

# Admin Configuration (REQUIRED)
ADMIN_SECRET=super-long-admin-bearer-token
INTERNAL_BEARER=super-long-random-string-here

# Withdrawal Limits
WITHDRAW_MAX_PER_TX=50
WITHDRAW_DAILY_CAP=500

# Monitoring Configuration (OPTIONAL)
ENABLE_METRICS=true
SLOW_QUERY_THRESHOLD_MS=500
ALERT_COOLDOWN_SECONDS=60

# Development/Runtime Configuration
NODE_ENV=production
GIT_SHA=auto_set_by_deployment

# Redis Configuration (OPTIONAL - for performance optimization)
# For local development:
# REDIS_URL=redis://localhost:6379
# For production (Railway automatically provides this):
# REDIS_URL=redis://username:password@host:port

# Prisma Configuration (OPTIONAL)
PRISMA_CLIENT_ENGINE_TYPE=binary